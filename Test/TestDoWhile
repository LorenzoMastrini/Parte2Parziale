program TestDoWhile();

var
    i: Integer;
    r: Real;
    b: Boolean;
    ch: Character;
    s: String;

begin
    // VALID CASES
    repeat
        i := i + 1
    until i > 10;

    repeat
        b := not b
    until b;

    repeat
        s := "looping"
    until s = "stop";

    repeat
        i := i - 1
    until (i = 0) or b;

    // Nested repeat-until
    repeat
        begin
            repeat
                i := i + 1
            until i > 5;
            b := false;
        end
    until b;

    // ERROR CASES
    repeat
        i := 1
    until 1;           // ERROR (ConditionNotBoolean)

    repeat
        b := true
    until "test";      // ERROR (ConditionNotBoolean)

    repeat
        ch := 'a'
    until ch;          // ERROR (ConditionNotBoolean)
end. 