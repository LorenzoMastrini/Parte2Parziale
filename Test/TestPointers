        name: String;
        age: Integer;
        next: ^Person;  // Puntatore a se stesso per liste concatenate
    end;
    PPerson = ^Person;
    
    // Array di puntatori
    PIntArray = array[1..5] of PInteger;
    
    // Puntatore a array
    PArray = ^array[1..10] of Integer;
    
    // Puntatore a puntatore
    PPInteger = ^PInteger;
