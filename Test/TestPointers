var
    // Dichiarazione di puntatori base
    pInt: ^Integer;
    pReal: ^Real;
    pBool: ^Boolean;
    pChar: ^Character;
    pStr: ^String;
    
    /*
    // Puntatori a strutture
    pPerson: PPerson;
    pPerson2: PPerson;
    */

    // Array di puntatori
    intPtrArray: array[1..5] of ^Integer;
    
    // Puntatore a array
    pArr: ^array[1..10] of Integer;
    
    // Puntatore a puntatore
    ppInt: ^^Integer;
    
    // Variabili temporanee
    i: Integer;
    r: Real;
    b: Boolean;
    c: Character;
    s: String;

begin
    // 1. Operazioni base con puntatori
    // Allocazione di memoria
    new(pInt);
    new(pReal);
    new(pBool);
    new(pChar);
    new(pStr);
    
    // Assegnazione di valori attraverso il puntatore
    pInt^ := 42;
    pReal^ := 3.14;
    pBool^ := true;
    pChar^ := 'A';
    pStr^ := 'Hello';
    
    // Lettura di valori attraverso il puntatore
    i := pInt^;
    r := pReal^;
    b := pBool^;
    c := pChar^;
    s := pStr^;
    
    /*
    // 2. Operazioni con puntatori a strutture
    new(pPerson);
    pPerson^.name := 'John';
    pPerson^.age := 30;
    
    // Creazione di una lista concatenata
    new(pPerson2);
    pPerson2^.name := 'Alice';
    pPerson2^.age := 25;
    pPerson^.next := pPerson2;
    pPerson2^.next := nil;
    
    // Navigazione nella lista
    pPerson := pPerson^.next;  // Muove al secondo elemento
    */

    // 3. Operazioni con array di puntatori
    for i := 1 to 5 do
    begin
        new(intPtrArray[i]);
        intPtrArray[i]^ := i * 10;
    end;
    
    // Accesso agli elementi dell'array di puntatori
    for i := 1 to 5 do
        intPtrArray[i]^ := intPtrArray[i]^ + 1;
    
    // 4. Operazioni con puntatore a array
    new(pArr);
    for i := 1 to 10 do
        pArr^[i] := i;
    
    // Accesso agli elementi dell'array attraverso il puntatore
    for i := 1 to 10 do
        pArr^[i] := pArr^[i] * 2;
    
    // 5. Operazioni con puntatore a puntatore
    new(ppInt);
    new(ppInt^);
    ppInt^^ := 100;  // Assegnazione attraverso doppia dereferenziazione
    
    // 6. Operazioni di confronto
    if pInt = nil then
        writeln('pInt è nil');
    
    if pPerson = pPerson2 then
        writeln('I puntatori puntano allo stesso oggetto');
    
    // 7. Operazioni di deallocazione
    dispose(pInt);
    dispose(pReal);
    dispose(pBool);
    dispose(pChar);
    dispose(pStr);
    
    /*
    // Deallocazione della lista concatenata
    while pPerson <> nil do
    begin
        pPerson2 := pPerson^.next;
        dispose(pPerson);
        pPerson := pPerson2;
    end;
    */

    // Deallocazione dell'array di puntatori
    for i := 1 to 5 do
        dispose(intPtrArray[i]);
    
    // Deallocazione del puntatore a array
    dispose(pArr);
    
    // Deallocazione del puntatore a puntatore
    dispose(ppInt^);
    dispose(ppInt);
    
    // 8. Esempio di uso di puntatori in funzioni
    // Nota: le funzioni che manipolano puntatori dovrebbero essere dichiarate
    // nella sezione delle dichiarazioni di funzioni
    
    // 9. Esempio di puntatori nulli
    pInt := nil;
    if pInt = nil then
        writeln('pInt è stato impostato a nil');
    
    // 10. Esempio di puntatori non inizializzati
    // Attenzione: questo è pericoloso e dovrebbe essere evitato
    // pInt^ := 42;  // Questo causerebbe un errore di runtime
end. 