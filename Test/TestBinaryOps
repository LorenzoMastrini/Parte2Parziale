program TestBinaryOps();

const
    c1 = 100;
    c2 = -0.5;
    c3 = "Hello";
    c4 = 'c';
    c5 = true;
    
var
    a, i: Integer;
    b: Real;
    c: Boolean;
    d: Character;
    e: String;

begin
    // VALID CASES
    // Arithmetic operations (+, -, *, /, div, mod)
    a + i;          // Integer + Integer = Integer
    3.0 + c2;       // Real + Real = Real
    1 + 3.0;        // Integer + Real = Real (promotion)
    1 + true;       // Integer + Boolean = Integer (promotion)
    1.5 + false;    // Real + Boolean = Real (promotion)
    
    10 - 3;         // Integer - Integer = Integer
    10.5 - 3.2;     // Real - Real = Real
    10 - 3.5;       // Integer - Real = Real (promotion)
    1 - true;       // Integer - Boolean = Integer (promotion)
    1.5 - false;    // Real - Boolean = Real (promotion)
    
    4 * 5;          // Integer * Integer = Integer
    4.5 * 2.0;      // Real * Real = Real
    4 * 2.5;        // Integer * Real = Real (promotion)
    1 * true;       // Integer * Boolean = Integer (promotion)
    1.5 * false;    // Real * Boolean = Real (promotion)
    
    8 / 4;          // Integer / Integer = Integer
    10.0 / 2.0;     // Real / Real = Real
    10 / 2.5;       // Integer / Real = Real (promotion)
    1 / true;       // Integer / Boolean = Integer (promotion)
    1.5 / false;    // Real / Boolean = Real (promotion)
    
    10 div 3;       // Integer div Integer = Integer
    1 div true;     // Integer div Boolean = Integer (promotion)
    c1 mod 2;       // Integer mod Integer = Integer
    1 mod false;    // Integer mod Boolean = Integer (promotion)

    // Logical operations (and, or)
    // Valid cases:
    true and false;  // Boolean and Boolean = Boolean
    true or false;   // Boolean or Boolean = Boolean
    c and true;      // Boolean and Boolean = Boolean
    c or false;      // Boolean or Boolean = Boolean
    
    // Comparison operations (=, <>, <, <=, >, >=)
    1.5 <> 2.0;      // Real <> Real = Boolean
    1 < 2.0;         // Integer < Real = Boolean
    1 <= 2;          // Integer <= Integer = Boolean
    1.5 <= 2.0;      // Real <= Real = Boolean
    false <= 2.0;    // Boolean <= Real = Boolean
    1.5 <= 2;        // Real <= Integer = Boolean
    3.5 > 2;         // Real > Integer = Boolean
    true >= false;   // Boolean >= Boolean = Boolean
    1 < true;        // Integer < Boolean = Boolean
    1.5 > false;     // Real > Boolean = Boolean
    'a' = 'b';       // Character = Character = Boolean
    'a' <> 'b';      // Character <> Character = Boolean

    // Combination of operations
    (a < b) and (8.9 > 2.0);  // (Int < Int): Boolean  and  (Real > Real): Boolean  = Boolean



    // ERROR CASES - Should generate "Incompatible types" errors [TypeError]
    // Arithmetic operations with non-numeric types
    1 + 'a';              // Integer + Character = ERROR
    1.5 + "hello";        // Real + String = ERROR
    'a' + 1;              // Character + Integer = ERROR
    "hello" + 1;          // String + Integer = ERROR
    
    1 - 'a';              // Integer - Character = ERROR
    1.5 - "hello";        // Real - String = ERROR
    
    1 * 'a';              // Integer * Character = ERROR
    1.5 * "hello";        // Real * String = ERROR
    
    1 / 'a';              // Integer / Character = ERROR
    1.5 / "hello";        // Real / String = ERROR

    1 div 'a';            // Integer div Character = ERROR
    1 mod "hello";        // Integer mod String = ERROR

    // Logical operations with non-boolean types
    true and 1;           // Boolean and Integer = ERROR
    false or 1.5;         // Boolean or Real = ERROR
    true and 'a';         // Boolean and Character = ERROR
    false or "hello";     // Boolean or String = ERROR
    1 and true;           // Integer and Boolean = ERROR
    1.5 or false;         // Real or Boolean = ERROR
    'a' and true;         // Character and Boolean = ERROR
    "hello" or false;     // String or Boolean = ERROR
    a and i;              // Integer and Integer = ERROR
    
    // Comparison operations
    1 = true;             // (Integer = Boolean) = ERROR
    1.5 = false;          // (Real = Boolean) = ERROR
    1 = 'a';              // (Integer = Character) = ERROR
    "hello" = 1.5;        // (String = Real) = ERROR
    1 = 2.0;              // (Integer = Real) = ERROR
    1 <= 'a';             // Integer <= Character = ERROR
    1.5 >= "hello";       // Real >= String = ERROR
    'a' <= 'b';           // Character > Character = ERROR
    'a' < 1;              // Character < Integer = ERROR
    'a' = true;           // Character = Boolean = ERROR
    false = "hello";      // Boolean = String = ERROR
    "hello" < "world";    // String < String = ERROR
    'a' < true;           // Character < Boolean = ERROR
    "hello" > false;      // String > Boolean = ERROR
    'a' < "b";            // Character < String = Boolean
end.