program TestForDownTo();

var
    i: Integer;
    r: Real;
    b: Boolean;
    ch: Character;
    s: String;

begin
    // VALID CASES
    for i := 10 downto 1 do
        i := i - 1;

    for i := i downto 0 do
        b := not b;

    for i := 5 downto 1 do
    begin
        s := "down";
        r := r - 1.0;
    end;

    // ERROR CASES
    for i := true downto 1 do    // ERROR: initial value not integer
        i := 1;

    for i := 10 downto false do  // ERROR: final value not integer
        i := 2;

    for r := 10 downto 1 do      // ERROR: control variable not integer
        r := r - 1.0;

    for b := 10 downto 1 do      // ERROR: control variable not integer
        b := false;

    for i := 10.5 downto 1 do    // ERROR: initial value not integer
        i := 3;

    for i := 10 downto 1.5 do    // ERROR: final value not integer
        i := 4;
end. 