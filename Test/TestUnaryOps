program TestUnaryOps();

var
    a: Integer;
    b: Real;
    c: Boolean;
    d: Character;
    e: String;
    p: ^Integer;
    q: ^^Integer;
    arr: array[1..3] of String;
    parr: ^Integer;

begin
    // VALID CASES
    // Unary operations (+, -, not, ^)
    +10;                // +Integer = Integer
    +15.5;              // +Real = Real
    +5;                 // +Integer = Integer
    -a;                 // +Integer = Integer
    
    -20;                // -Integer = Integer
    -25.5;              // -Real = Real
    
    not true;           // not Boolean = Boolean
    not false;          // not Boolean = Boolean

    ^a;                 // Ref: address of variable (Pointer to Integer)
    ^arr;               // (Pointer to Array of String) 
    ^p^;                // Ref: address of dereferenced pointer (Ponter to Integer)
    ^(p^);              // Ref: address of dereferenced pointer (Pointer to Integer)
    p^;                 // Dereference pointer (Integer)
    q^^;                // Double dereference (Integer)
    q^;                 // Double dereference (Pointer to Integer)
    ^p;                 // Ref of a pointer (Pointer to Pointer Integer)




    // ERROR CASES
    // Unary plus on non-numeric types
    +true;              // + Boolean = ERROR
    +'a';               // + Character = ERROR
    +"hello";           // + String = ERROR

    // Unary minus on non-numeric types
    -true;              // - Boolean = ERROR
    -'a';               // - Character = ERROR
    -"hello";           // - String = ERROR
    
    // Unary not on non-boolean types
    not 1;              // not Integer = ERROR
    not 1.5;            // not Real = ERROR
    not 'a';            // not Character = ERROR
    not "hello";        // not String = ERROR
    not a;              // not Integer = ERROR

    // ERROR CASES - References and pointers
    ^42;              // Ref of a literal
    ^(a + 1);         // Ref of an expression
    ^"hello";         // Ref of a string literal
    ^arr[1];            // Ref: address of array element
    ^(arr[1] + 1);    // Ref of an expression
    ^(p^ + 1);        // Ref of an expression
end.