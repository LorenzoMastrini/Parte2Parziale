program TestFunCall();

var
    a: Integer;
    b: Real;
    c: Boolean;
    d: Character;
    e: String;
    v: Integer;
    w: Integer;
    z: Integer;


    function sum(x: Integer, y: Integer): Integer;
        begin
            return x + y;
        end;

    function concatenate(s1, s2: String): String;
        begin
            return s1;
        end;

    function invert(b: Boolean): Boolean;
        begin
            return not b;
        end;

    // PARAMETER PASSING MODALITIES TESTS
    // --- BY VALUE ---
    function byValue(x: Integer): Integer;
        begin
            x := x + 1;
            return x;
        end;
    
    // --- BY REFERENCE ---
    function byReference(var x: Integer): Integer;
        begin
            x := x + 1; // Should affect the caller
            return x;
        end;

    procedure compat(x: String);
        begin
            x;
        end;


begin
    // VALID CASES
    // Function call
    sum(1, 2);                              // Integer, Integer -> Integer
    sum(a, 5);                              // Integer, Integer -> Integer
    concatenate("Hello", " world");         // String, String -> String
    concatenate(e, "!");                    // String, String -> String
    invert(true);                           // Boolean -> Boolean
    invert(c);                              // Boolean -> Boolean
    sum(sum(1,2), 3);                       // Nested Function: (Integer, Integer -> Integer), Integer -> Integer
    concatenate(concatenate("a","b"), "c"); // Nested Function: (String, String -> String), String -> String

    // ERROR CASES
    d();                    // ERROR (NotAFunction)
    h();                    // ERROR (FunNotDefined)
    sum(1.5, 2);            // ERROR (FunArgTypeMismatch)
    compat('a');            // ERROR (FunArgTypeMismatch)
    sum("a", 2);            // ERROR (FunArgTypeMismatch)
    sum(true, false);       // ERROR (FunArgTypeMismatch)
    concatenate(1, 2);      // ERROR (FunArgTypeMismatch)
    concatenate("a", 2);    // ERROR (FunArgTypeMismatch)
    invert(1);              // ERROR (FunArgTypeMismatch)
    invert("true");         // ERROR (FunArgTypeMismatch)
    sum(1);                 // ERROR (FunArgsNumMismatch)
    concatenate("a");       // ERROR (FunArgsNumMismatch)
    invert();               // ERROR (FunArgsNumMismatch)


    // PARAMETER PASSING MODALITIES TESTS
    v := 10;
    w := 20;
    z := 30;

    byValue(v);             // By Value: Integer (compatible with Integer)
    byValue(c);             // By Value: Boolen (compatible with Integer)
    byReference(w);         // By Reference: Integer
    
    // ERROR CASES
    byValue(b);             // ERROR: (By Value) Real not compatible with Integer
    byValue(e);             // ERROR: (By Value) String not compatible with Integer
    byReference(v / 7);     // ERROR (NotLExprInMod)
    byReference(b);         // ERROR (IncompatibleRefModParamType)
    byReference(c);         // ERROR (IncompatibleRefModParamType)
end.