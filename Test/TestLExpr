program TestLExpr();

var
    a: Integer;
    b: Real;
    arr: array[1..5] of Integer;
    parr: ^Integer;
    mat: array[1..3] of array[1..3] of Integer;
    pmat: ^array[1..3] of array[1..3] of Integer;
    pa: ^Integer;
    pp: ^^Integer;

begin
    // VALID CASES
    //LId
    a;
    b;

    // LArr
    arr[1];
    mat[2][3];
    pmat^[1][2];

    // LDeref
    pa^;
    pp^^;
    ^pa;
    parr^;  // Integer
    ^pp^;

    // Combinations
    ^arr[1];    // ^Integer



    // ERROR CASES
    parr^[1];       // ERROR (NotAnArray)
    parr[1];        // ERROR (NotAnArray)
    a[1];           // ERROR (NotAnArray)
    arr[6];         // ERROR (OutOfBound)
    arr[3*8];       // ERROR (OutOfBound)
    mat[0][1];      // ERROR (OutOfBound)
    arr[2]^;        // ERROR (NotAPointer)
    b^;             // ERROR (NotAPointer)
    pmat^[4][1];    // ERROR (OutOfBound)
end.