program TestLExpr();

var
    a: Integer;
    b: Real;
    arr: array[1..5] of Integer;
    parr: ^Integer;
    mat: array[1..3] of array[1..3] of Integer;

begin
    // VALID CASES
    a;              // LId
    b;              // LId
    arr[1];         // LArr
    arr[a];         // LArr with variable index
    mat[2][3];      // Nested LArr
    parr^;          // LDeref
    arr[parr^];     // LArr with LDeref as index

    // ERROR CASES
    arr[0];         // Indice fuori range (se gestito)
    arr[1.5];       // Indice non intero
    arr["a"];       // Indice non intero
    mat[1];         // Accesso incompleto (manca secondo indice)
    parr^^;         // Doppia dereferenziazione (se non consentita)
    c;              // Variabile non dichiarata
    arr[a, b];      // Troppi indici (se non consentito)
end.



var
    p: ^Integer
    a: Integer
    b: Integer

begin
    a := 10;
    p := ^a;
    a := b;
    p^ := 6;
end.