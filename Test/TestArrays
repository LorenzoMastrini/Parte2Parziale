program ArrayOperations();

const
    MAX_SIZE = 10;
    MIN_VALUE = 1;
    MAX_VALUE = 100;

var
    // Array monodimensionale di interi
    numbers: array[1..MAX_SIZE] of Integer;
    
    // Array monodimensionale di reali
    temperatures: array[0..5] of Real;
    
    // Array monodimensionale di caratteri
    letters: array['A'..'Z'] of Character;
    
    // Array monodimensionale di stringhe
    names: array[1..3] of String;
    
    // Array bidimensionale (matrice)
    matrix: array[1..3, 1..3] of Integer;
    
    // Array di array (array di array)
    jaggedArray: array[1..3] of array[1..5] of Integer;
    
    // Array con indici personalizzati
    customArray: array[MIN_VALUE..MAX_VALUE] of Boolean;
    
    // Variabili per gli esempi
    i, j: Integer;
    sum: Integer;
    temp: Real;
    ch: Character;

begin
    // 1. Inizializzazione di array monodimensionali
    // Inizializzazione con ciclo
    for i := 1 to MAX_SIZE do
        numbers[i] := i * 2;
    
    // Inizializzazione diretta
    temperatures[0] := 20.5;
    temperatures[1] := 21.0;
    temperatures[2] := 22.5;
    
    // Inizializzazione di array di caratteri
    for ch := 'A' to 'Z' do
        letters[ch] := ch;
    
    // Inizializzazione di array di stringhe
    names[1] := 'Alice';
    names[2] := 'Bob';
    names[3] := 'Charlie';
    
    // 2. Operazioni con array monodimensionali
    // Accesso e modifica di elementi
    numbers[1] := 100;
    temp := temperatures[0];
    
    // Somma di tutti gli elementi
    sum := 0;
    for i := 1 to MAX_SIZE do
        sum := sum + numbers[i];
    
    // Ricerca di un elemento
    i := 1;
    while (i <= MAX_SIZE) and (numbers[i] <> 100) do
        i := i + 1;
    
    // 3. Operazioni con array bidimensionali
    // Inizializzazione di una matrice
    for i := 1 to 3 do
        for j := 1 to 3 do
            matrix[i,j] := i + j;
    
    // Accesso e modifica di elementi della matrice
    matrix[1,1] := 10;
    temp := matrix[2,2];
    
    // Somma di una riga della matrice
    sum := 0;
    for j := 1 to 3 do
        sum := sum + matrix[1,j];
    
    // 4. Operazioni con array di array (jagged array)
    // Inizializzazione
    for i := 1 to 3 do
        for j := 1 to 5 do
            jaggedArray[i][j] := i * j;
    
    // Accesso e modifica
    jaggedArray[1][1] := 100;
    temp := jaggedArray[2][3];
    
    // 5. Operazioni con array personalizzati
    // Inizializzazione
    for i := MIN_VALUE to MAX_VALUE do
        customArray[i] := (i mod 2) = 0;
    
    // Accesso e modifica
    customArray[50] := true;
    
    // 6. Esempi di operazioni comuni
    // Copia di array
    for i := 1 to MAX_SIZE do
        numbers[i] := matrix[1,i];
    
    // Inversione di array
    for i := 1 to MAX_SIZE div 2 do
    begin
        temp := numbers[i];
        numbers[i] := numbers[MAX_SIZE - i + 1];
        numbers[MAX_SIZE - i + 1] := temp;
    end;
    
    // Ordinamento (bubble sort)
    for i := 1 to MAX_SIZE - 1 do
        for j := 1 to MAX_SIZE - i do
            if numbers[j] > numbers[j + 1] then
            begin
                temp := numbers[j];
                numbers[j] := numbers[j + 1];
                numbers[j + 1] := temp;
            end;
end. 