entrypoints Program ;

-- Program
-- TODO: decidere se lasciare anche la produzione senza parametri
ProgNoParams. Program ::= "program" Ident ";" Block "." ;
Prog.         Program ::= "program" Ident "(" [Ident] ")" ";" Block "." ;

separator nonempty Ident "," ;

-- Block
Block.  Block ::= DeclarationPart CompoundStatement;

-- Declarations
Decls.  DeclarationPart ::= ConstantDefinitionPart VariableDeclarationPart [ProcedureAndFunctionDeclaration] ;

-- Constants
NoConstDefs.  ConstantDefinitionPart ::= ;
ConstDefs.    ConstantDefinitionPart ::= "const" [ConstantDefinition] ;
ConstDef.     ConstantDefinition ::= Ident "=" Constant ;
terminator nonempty ConstantDefinition ";" ;

-- Variables
NoVarDecls. VariableDeclarationPart ::= ;
VarDecls.   VariableDeclarationPart ::= "var" [VariableDeclaration] ;
VarDecl.    VariableDeclaration ::= [Ident] ":" Type ;
terminator nonempty VariableDeclaration ";" ;

-- Procedure and Functions
ProcFunDecl.   ProcedureAndFunctionDeclaration ::= ProcedureAndFunctionHeading Block;
separator ProcedureAndFunctionDeclaration ";" ;

ProcDecl. ProcedureAndFunctionHeading ::= "procedure" Ident "(" [FormalParameters] ")" ";" ;
FunDecl.  ProcedureAndFunctionHeading ::= "function" Ident "(" [FormalParameters] ")" ":" Type ";";

FormParam. FormalParameters ::= OptModality [Ident] ":" Type ;
separator FormalParameters "," ;

ByVal.    OptModality ::= ;
ByRef.    OptModality ::= "var" ;
ByValRes. OptModality ::= "valres" ;


--Types
Array.    Type ::= "array" "[" [IndexType] "]" "of" Type ;
Pointer.  Type ::= "^" Type ;
Basic.    Type ::= BasicType ;
rules BasicType ::= "Integer" | "Real" | "Boolean" | "Character" | "String" ;

IndexRange. IndexType ::= Constant ".." Constant ;
separator nonempty IndexType "," ;

Const.      Constant ::= OptSign IdentOrNumber ;
ConstStr.   Constant ::= String ;
ConstId.    IdentOrNumber ::= Ident ;
ConstInt.   IdentOrNumber ::= Integer ;
ConstFloat. IdentOrNumber ::= Double ;
rules OptSign ::= {- empty -} | "+" | "-" ;


-- Statements
CompStmt.   CompoundStatement ::= "begin" [Statement] "end" ;
Stmts.      Statement ::= CompoundStatement ;
NoStmt.     Statement ::= ;
RExprStmt.  Statement ::= RExpr ;
Assign.     Statement ::= LExpr ":=" RExpr ;
While.      Statement ::= "while" RExpr "do" Statement ;
DoWhile.    Statement ::= "repeat" Statement "until" RExpr ;
ForTo.      Statement ::= "for" LExpr ":=" RExpr "to" RExpr "do" Statement ;
If.         Statement ::= "if" RExpr "then" Statement OptElse ;
NoElse.     OptElse ::= ;
Else.       OptElse ::= "else" Statement ;
Case.       Statement ::= "case" RExpr "of" [CaseItem] "end" ;
CaseItem.   CaseItem ::= Constant ":" Statement ;
separator CaseItem ";" ;
separator nonempty Statement ";" ;

-- Expressions
LId.    LExpr ::= Ident ;
LArr.   LExpr ::= LExpr "[" [RExpr] "]" ;
LDeref. LExpr ::= LExpr "^" ;
Binary. RExpr ::= RExpr Binary RExpr ;
Unary.  RExpr ::= Unary RExpr ;
Lit.    RExpr ::= Literal ;
FCall.  RExpr ::= Ident "(" [RExpr] ")" ;
_.      RExpr ::= "(" RExpr ")" ;
LExpr.  RExpr ::= LExpr ;
separator RExpr "," ;

rules Literal ::= Integer | Double | Char | String | "true" | "false" ;
rules Binary  ::= "+" | "-" | "*" | "/" | "div" | "mod" | "or" | "and" | "=" | "<>" | "<" | "<=" | ">" | ">=" ;
rules Unary   ::= "+" | "-" | "not" ;

-- Comments
comment "//" ;
comment "/*" "*/" ;