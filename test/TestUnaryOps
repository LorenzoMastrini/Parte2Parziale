program TestUnaryOps();

var
    a: Integer;
    b: Real;
    c: Boolean;
    d: Character;
    e: String;

begin
    // Unary operations (+, -, not)
    // Valid cases:
    +10;             // + Integer = Integer
    -20;             // - Integer = Integer
    +15.5;           // + Real = Real
    -25.5;           // - Real = Real
    not true;        // not Boolean = Boolean
    not false;       // not Boolean = Boolean


    // ERROR CASES - Should generate "Incompatible types" errors [TypeError]:

    // Unary plus on non-numeric types
    +true;           // + Boolean = ERROR
    +'a';            // + Character = ERROR
    +"hello";        // + String = ERROR

    // Unary minus on non-numeric types
    -true;           // - Boolean = ERROR
    -'a';            // - Character = ERROR
    -"hello";        // - String = ERROR
    
    // Unary not on non-boolean types
    not 1;           // not Integer = ERROR
    not 1.5;         // not Real = ERROR
    not 'a';         // not Character = ERROR
    not "hello";     // not String = ERROR
end.